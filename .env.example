# Public URL used for metadata, sitemap and Stripe return links.
# Production: https://www.morsemedia.co   Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Contact & newsletter forms (set these for launch) ─────────────────────────
# With Resend configured, inquiries arrive in your inbox and "Reply" goes to the visitor.
# Sender domain must be verified in Resend (DNS records at your domain provider).
RESEND_API_KEY=
CONTACT_EMAIL_FROM=Morse Media <website@morsemedia.co>
CONTACT_EMAIL_TO=hello@morsemedia.co
# Optional: a Resend key with Full access, so newsletter sign-ups are saved as real contacts
# (the sending-only key above cannot manage contacts).
RESEND_CONTACTS_API_KEY=
# Optional: shows a "Book a call" button on Services (e.g. your Calendly link).
NEXT_PUBLIC_BOOKING_URL=
# Optional alternative: send submissions to Formspree, Zapier, Make, etc. (takes priority if set).
# With neither configured, the forms fall back to opening a pre-filled email.
CONTACT_FORM_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_URL=
FORM_WEBHOOK_SECRET=

# Google Analytics 4
NEXT_PUBLIC_GA_ID=G-Q60YZCS3S9

# Optional Google Search Console HTML verification token (not a secret).
GOOGLE_SITE_VERIFICATION=

# ── Online print store (leave unset to run the shop in "request a print" mode) ─
# The bag and checkout only appear once Stripe + Prodigi + order email + the catalog
# below are all configured. See STORE-SETUP.md before setting any of these.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STORE_SHIPPING_RATE_CENTS=1200
STRIPE_AUTOMATIC_TAX=false
PRODIGI_MODE=sandbox
STORE_LIVE_ENABLED=false
PRODIGI_API_KEY=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PRODIGI_CALLBACK_SECRET=
# JSON keyed by exact Morse Media SKU; see STORE-SETUP.md. Never use website preview images.
PRODIGI_CATALOG_JSON={}
ORDER_EMAIL_FROM=
ORDER_ALERT_EMAIL=
# Print-readiness guard: minimum pixels per inch for a size to be sold (100–300, default 150).
# Record each master's pixel size in data/print-masters.ts (npm run masters:check -- "folder").
PRINT_MIN_PPI=150

# Newsletter welcome email (sent from CONTACT_EMAIL_FROM through Resend). Set to "off" to disable.
NEWSLETTER_WELCOME=on
