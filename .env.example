# Public URL used for metadata, sitemap and Stripe return links.
# Local development:
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe test keys from the Stripe dashboard.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Add after running: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Flat shipping amount in cents. Change this after confirming your real production/shipping cost.
STORE_SHIPPING_RATE_CENTS=1200

# Set true only after Stripe Tax is configured for your account.
STRIPE_AUTOMATIC_TAX=false

# Optional: completed-order automation endpoint supplied by an approved fulfillment workflow.
PRINTIQUE_ORDER_WEBHOOK_URL=
FULFILLMENT_WEBHOOK_SECRET=

# Optional: send contact/newsletter submissions to Formspree, Zapier, Make, your own API, etc.
# Without these, the forms gracefully open a pre-filled email to hello@morsemedia.co.
CONTACT_FORM_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_URL=
FORM_WEBHOOK_SECRET=
